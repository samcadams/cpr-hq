{
  "id": "cpr-hq",
  "title": "CPR HQ",
  "description": "Crew Headquarters for Cyberpunk RED, based on the No Place Like Home DLC. A Journal Entry with a custom sheet tracks HQ IP, Improvements and Upgrades, and the crew benefits they grant.",
  "version": "1.1.1",
  "license": "LICENSE",
  "authors": [
    {
      "name": "samsamsamsam"
    }
  ],
  "url": "https://github.com/samcadams/cpr-hq",
  "bugs": "https://github.com/samcadams/cpr-hq/issues",
  "manifest": "https://github.com/samcadams/cpr-hq/releases/latest/download/module.json",
  "download": "https://github.com/samcadams/cpr-hq/releases/download/v1.0.0/cpr-hq.zip",
  "compatibility": {
    "minimum": "12",
    "verified": "12",
    "maximum": "12"
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/cpr-hq.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "cyberpunk-red-core",
        "type": "system",
        "compatibility": {
          "minimum": "v0.92.4"
        }
      }
    ],
    "requires": [
      {
        "id": "socketlib",
        "type": "module"
      }
    ],
    "recommends": [
      {
        "id": "cpr-sam-agent",
        "type": "module",
        "reason": "The Agent phone: bills as BangMe! invoices, Trauma Team and app subscriptions on the Lifestyle bill, app downtime activities, Crew Notes on the phone.",
        "compatibility": {
          "minimum": "1.2.0"
        }
      }
    ]
  },
  "socket": true,
  "packs": [
    {
      "name": "hq-macros",
      "label": "HQ Macros",
      "path": "packs/hq-macros",
      "type": "Macro",
      "system": "cyberpunk-red-core",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {}
    }
  ]
}
