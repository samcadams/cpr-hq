<div class="cpr-hq-table-rules-body">
  {{#each groups}}
  <section class="tr-group">
    <h3 class="tr-title">{{label}}</h3>
    <p class="hint">{{hint}}</p>
    {{#each fields}}
    <div class="form-group">
      <label for="{{id}}">{{name}}</label>
      <div class="form-fields">
        {{#if checkbox}}
        <input type="checkbox" id="{{id}}" name="{{key}}" {{checked value}}>
        {{else if choices}}
        <select id="{{id}}" name="{{key}}">
          {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        {{else if number}}
        <input type="number" id="{{id}}" name="{{key}}" value="{{value}}" min="{{range.min}}" max="{{range.max}}" step="{{range.step}}">
        {{else}}
        <input type="text" id="{{id}}" name="{{key}}" value="{{value}}">
        {{/if}}
      </div>
      <p class="hint">{{hint}}</p>
    </div>
    {{/each}}
  </section>
  {{/each}}
</div>
